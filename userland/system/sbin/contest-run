#!/bin/sh
# 在系统根挂载比赛工作盘，依次运行原 musl、glibc 输入；父进程始终保留系统根。
set -e
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

if [ "$#" -eq 0 ]; then
    echo 'Usage: contest-run DEVICE [basic|busybox|lua|dynamic:NAME|static:NAME ...]' >&2
    exit 2
fi
device=$1
shift
case "$device" in
    /dev/vd[a-z]) ;;
    *) echo "CONTEST invalid device: $device" >&2; exit 2 ;;
esac
if [ "$#" -eq 0 ]; then
    set -- basic busybox lua \
        dynamic:argv dynamic:env dynamic:clock_gettime dynamic:stat dynamic:socket \
        dynamic:dlopen dynamic:tls_init dynamic:tls_local_exec \
        dynamic:pthread_cond dynamic:pthread_tsd \
        static:argv static:env static:clock_gettime static:stat static:socket \
        static:pthread_cond static:pthread_tsd
fi
# 固定原 static.txt 没有 dlopen、tls_init、tls_local_exec，不能将未知入口算作对照。
for project in "$@"; do
    case "$project" in
        basic|busybox|lua|dynamic:argv|dynamic:env|dynamic:clock_gettime|dynamic:stat|dynamic:socket|dynamic:dlopen|dynamic:tls_init|dynamic:tls_local_exec|dynamic:pthread_cond|dynamic:pthread_tsd|static:argv|static:env|static:clock_gettime|static:stat|static:socket|static:pthread_cond|static:pthread_tsd) ;;
        *) echo "CONTEST unknown project: $project" >&2; exit 2 ;;
    esac
done
projects="$*"
basic_tests='brk chdir clone close dup2 dup execve exit fork fstat getcwd getdents getpid getppid gettimeofday mkdir_ mmap mount munmap openat open pipe read sleep times umount uname unlink wait waitpid write yield'
lua_tests='date.lua file_io.lua max_min.lua random.lua remove.lua round_num.lua sin30.lua sort.lua strings.lua'
contest=/mnt/contest
logs=/tmp/contest-run.$$
contest_mounted=0
family_mounts=
family=
pending="$projects"
phase=prepare
failed=0

# 按实际取得顺序的逆序卸载本族；失败保留诊断，禁止 lazy 或强制卸载。
cleanup_family() {
    local target result=0
    for target in $family_mounts; do
        if ! /bin/busybox umount "$target"; then
            echo "CONTEST cleanup failed: $target" >&2
            result=1
        fi
    done
    family_mounts=
    return "$result"
}

# 准备错误也结束当前运行并报告尚未执行的项目；自然关机只在真实 wait 和卸载之后请求。
finish() {
    local status=$? project
    trap - EXIT
    set +e
    if [ "$status" -ne 0 ]; then
        echo "CONTEST error phase=$phase family=${family:-none} status=$status" >&2
        for project in $pending; do
            echo "CONTEST result family=${family:-musl} project=$project outcome=NotRun"
        done
        if [ "$family" != glibc ]; then
            for project in $projects; do
                echo "CONTEST result family=glibc project=$project outcome=NotRun"
            done
        fi
    fi
    cleanup_family || status=1
    if [ "$contest_mounted" -eq 1 ]; then
        if ! /bin/busybox umount "$contest"; then
            echo "CONTEST cleanup failed: $contest" >&2
            status=1
        fi
    fi
    /bin/busybox rm -rf "$logs" || status=1
    /bin/busybox sync || status=1
    if [ "$failed" -ne 0 ]; then
        status=1
    fi
    echo "CONTEST finished status=$status"
    /bin/busybox poweroff || status=1
    exit "$status"
}
trap finish EXIT

# 只部署匹配 runtime 的普通库和链接，原 BusyBox、脚本、测试 DSO 均不改写。
prepare_family() {
    local project library name
    [ -x "$root/busybox" ]
    [ -d "/opt/runtime/$family/lib" ]
    for project in $projects; do
        case "$project" in
            basic)
                [ -f "$root/basic/run-all.sh" ]
                /bin/busybox chmod a+x "$root/basic/run-all.sh"
                for name in $basic_tests test_echo; do
                    [ -x "$root/basic/$name" ]
                done
                ;;
            busybox)
                [ -x "$root/busybox_testcode.sh" ]
                [ -f "$root/busybox_cmd.txt" ]
                ;;
            lua)
                [ -f "$root/lua_testcode.sh" ]
                [ -x "$root/test.sh" ]
                [ -x "$root/lua" ]
                for name in $lua_tests; do
                    [ -f "$root/$name" ]
                done
                ;;
            dynamic:*|static:*)
                [ -x "$root/runtest.exe" ]
                [ -x "$root/entry-${project%%:*}.exe" ]
                ;;
        esac
    done
    /bin/busybox mkdir -p "$root/lib" "$root/bin" "$root/dev" "$root/proc" "$root/tmp"
    for library in /opt/runtime/"$family"/lib/*; do
        [ -f "$library" ]
        name=${library##*/}
        /bin/busybox rm -f "$root/lib/$name"
        /bin/busybox cp -P "$library" "$root/lib/$name"
    done
    if [ "$family" = musl ]; then
        case " $projects " in
            *" basic "*)
                for library in /opt/runtime/glibc/lib/ld-linux-*.so.1; do
                    [ -f "$library" ]
                    name=${library##*/}
                    /bin/busybox rm -f "$root/lib/$name"
                    /bin/busybox cp -P "$library" "$root/lib/$name"
                done
                ;;
        esac
    fi
    if [ -L "/opt/runtime/$family/lib64" ]; then
        /bin/busybox rm -f "$root/lib64"
        /bin/busybox ln -s lib "$root/lib64"
    fi
    for name in busybox sh ls sleep; do
        /bin/busybox rm -f "$root/bin/$name"
        /bin/busybox ln -s /busybox "$root/bin/$name"
    done
    /bin/busybox mount -t devfs devfs "$root/dev"
    family_mounts="$root/dev"
    /bin/busybox mount -t proc proc "$root/proc"
    family_mounts="$root/proc $family_mounts"
    /bin/busybox mount -t tmpfs tmpfs "$root/tmp"
    family_mounts="$root/tmp $family_mounts"
}

# 子进程先进入族目录；chroot applet 真正换根并 chdir("/")，再 exec 原入口。
execute_project() {
    cd "$root" || exit "$?"
    export LD_LIBRARY_PATH=/lib
    export PATH=/bin:/
    case "$1" in
        basic|lua)
            exec /bin/busybox chroot . /busybox sh "./${1}_testcode.sh"
            ;;
        busybox)
            exec /bin/busybox chroot . ./busybox_testcode.sh
            ;;
        dynamic:*|static:*)
            exec /bin/busybox chroot . ./runtest.exe -w "entry-${1%%:*}.exe" "${1#*:}"
            ;;
    esac
}

# 只判断原输出中的完整行；grep 的 I/O 错误不能等同于字段缺失。
has_line() {
    local result
    if /bin/busybox grep -F -x -q "$1" "$log"; then
        return 0
    else
        result=$?
        [ "$result" -eq 1 ] || exit "$result"
        return 1
    fi
}

# basic 原包装吞原子退出状态；逐项保 START/END 与源码明确失败字段，完整结束不称评分 Pass。
classify_basic() {
    local name marker line active started ended atom_failed atom_outcome
    for name in $basic_tests; do
        marker=test_$name
        case "$name" in mkdir_) marker=test_mkdir ;; esac
        active=0
        started=0
        ended=0
        atom_failed=0
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                "Testing $name :") active=1 ;;
                'Testing '*) active=0 ;;
            esac
            [ "$active" -eq 1 ] || continue
            case "$line" in
                "========== START $marker ==========") started=1 ;;
                "========== END $marker ==========") ended=1 ;;
                '========== END main ==========')
                    if [ "$name" = execve ]; then ended=1; fi
                    ;;
                'clone process error.'|'  execve error.'|'exit ERR.'|'getcwd ERROR.'|'  getppid error.'|'gettimeofday error.'|'  mkdir error.'|'mmap error.'|'sleep error.'|'  unlink error!'|'wait child error.'|'waitpid error.')
                    atom_failed=1
                    ;;
                'mount return: '*|'umount return: '*)
                    if [ "${line##*: }" != 0 ]; then atom_failed=1; fi
                    ;;
            esac
        done < "$log"
        if [ "$started" -eq 0 ]; then
            atom_outcome=NotRun
        elif [ "$ended" -eq 0 ] || [ "$atom_failed" -ne 0 ]; then
            atom_outcome=Failed
        else
            atom_outcome=Completed
        fi
        echo "CONTEST atomic family=$family project=basic name=$name outcome=$atom_outcome"
        if [ "$atom_outcome" != Completed ]; then
            classified=Failed
        fi
    done
}

# 保原组边界、内部逐项结果与 runtest 的特殊返回协议，不解释其它组的评分文字。
classify_project() {
    local command name kind selector
    classified=Failed
    case "$project" in
        basic|busybox|lua)
            classified=NotRun
            if has_line "#### OS COMP TEST GROUP START $project-$family ####"; then
                classified=Completed
                if [ "$exit_status" -ne 0 ] || ! has_line "#### OS COMP TEST GROUP END $project-$family ####"; then
                    classified=Failed
                fi
            fi
            case "$project" in
                basic) classify_basic ;;
                busybox)
                    # 原 wrapper 使用普通 read；这里保留相同的空白和反斜线消费语义。
                    while read command || [ -n "$command" ]; do
                        if ! has_line "testcase busybox $command success"; then
                            classified=Failed
                        fi
                        if has_line "testcase busybox $command fail"; then
                            classified=Failed
                        fi
                    done < "$root/busybox_cmd.txt"
                    ;;
                lua)
                    for name in $lua_tests; do
                        if ! has_line "testcase lua $name success"; then
                            classified=Failed
                        fi
                        if has_line "testcase lua $name fail"; then
                            classified=Failed
                        fi
                    done
                    ;;
            esac
            ;;
        dynamic:*|static:*)
            classified=NotRun
            kind=${project%%:*}
            selector=${project#*:}
            # 固定 runtest 在 Pass! 和失败分支末尾都 return 1，必须同时核正文。
            has_line "========== START entry-$kind.exe $selector ==========" || return 0
            classified=Failed
            [ "$exit_status" -eq 1 ] || return 0
            has_line "========== END entry-$kind.exe $selector ==========" || return 0
            has_line 'Pass!' || return 0
            while IFS= read -r command || [ -n "$command" ]; do
                case "$command" in "FAIL $selector "*) return 0 ;; esac
            done < "$log"
            classified=Pass
            ;;
    esac
}

/bin/busybox mkdir "$logs"
/bin/busybox mkdir -p "$contest"
/bin/busybox mount -t ext4 "$device" "$contest"
contest_mounted=1
echo "CONTEST selection $projects"
for family in musl glibc; do
    root=$contest/$family
    pending="$projects"
    phase=prepare:$family
    prepare_family
    for project in $projects; do
        phase=execute:$family:$project
        log=$logs/$family-$project.log
        # 原组执行不使用 errexit；真实子状态与正文分别保存，cat 不参与子结果判定。
        set +e
        execute_project "$project" > "$log" 2>&1 &
        child=$!
        wait "$child"
        exit_status=$?
        pending=${pending#"$project"}
        pending=${pending# }
        set -e
        /bin/busybox cat "$log"
        classify_project
        echo "CONTEST result family=$family project=$project outcome=$classified exit=$exit_status"
        if [ "$classified" != Completed ] && [ "$classified" != Pass ]; then failed=1; fi
    done
    phase=cleanup:$family
    cleanup_family
done
phase=finished
exit "$failed"
