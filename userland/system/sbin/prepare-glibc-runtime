#!/bin/sh
# 补充缺失的 libgcc 和 C.UTF-8 locale 前，核对测试根 libc 与 loader 的 SHA256 身份。
# 由系统根的静态 BusyBox 执行；测试根须已准备 /.blossom/busybox。
set -eu

bb=/bin/busybox
runtime=/opt/runtime/glibc
lib_tmp=
locale_tmp=

# 保留原始失败状态，并只清理本次创建的临时文件。
cleanup() {
    status=$?
    trap - EXIT
    [ -z "$lib_tmp" ] || "$bb" rm -f "$lib_tmp" || status=1
    [ -z "$locale_tmp" ] || "$bb" rm -rf "$locale_tmp" || status=1
    exit "$status"
}

# 所有准备失败都向执行器传递非零状态。
fail() {
    printf 'prepare-glibc-runtime: %s\n' "$*" >&2
    exit 1
}

# 禁止沿工作根内的父目录符号链接写入其他位置。
check_parent() {
    [ ! -L "$1" ] || fail "target parent is a symbolic link: $1"
    if [ -e "$1" ] && [ ! -d "$1" ]; then
        fail "target parent is not a directory: $1"
    fi
}

# 判断参数是否为 64 位小写十六进制 SHA256。
is_sha256() {
    case $1 in
        *[!0-9a-f]*) return 1 ;;
    esac
    [ "${#1}" -eq 64 ]
}

# 读取系统根中的 glibc 身份文件，内容为以单个空格分隔的一行
# "<libc SHA256> <loader SHA256> <loader 文件名>"，结果保存在 libc_sum、loader_sum 和
# loader_name。loader 文件名只接受 RISC-V 与 LoongArch 两个固定名称；字段缺失、字段多余、
# 多余行、额外空白或 SHA256 格式错误都使准备失败。
read_identity() {
    identity=$runtime/identity
    [ -f "$identity" ] && [ ! -L "$identity" ] && [ -s "$identity" ] ||
        fail "missing or invalid runtime identity: $identity"
    # 末行缺少换行时 read 返回非零；第二次 read 必须直接遇到 EOF，才能排除多余内容。
    {
        IFS= read -r identity_line &&
            ! IFS= read -r identity_extra &&
            [ -z "$identity_extra" ]
    } < "$identity" || fail "unreadable or malformed runtime identity: $identity"
    # 只在单个空格处切分；多余的空格或字段会留在某个字段内，由下面的检查拒绝。
    libc_sum=${identity_line%% *}
    identity_rest=${identity_line#* }
    loader_sum=${identity_rest%% *}
    loader_name=${identity_rest#* }
    is_sha256 "$libc_sum" && is_sha256 "$loader_sum" ||
        fail "invalid SHA256 in runtime identity: $identity"
    case $loader_name in
        ld-linux-riscv64-lp64d.so.1|ld-linux-loongarch-lp64d.so.1) ;;
        *) fail "unsupported loader in runtime identity: '$loader_name'" ;;
    esac
}

# 输出测试根内路径 $1 所指普通文件的 SHA256 记录。最终组件是符号链接时交给测试根内的
# BusyBox 在 chroot 中解析，绝对链接才会指向测试根而不是系统根。
root_sha256() {
    if [ -L "$root$1" ]; then
        "$bb" chroot "$root" /.blossom/busybox sh -c \
            '[ -f "$1" ] && /.blossom/busybox sha256sum "$1"' sh "$1"
    else
        [ -f "$root$1" ] && "$bb" sha256sum "$root$1"
    fi
}

# 核对测试根内路径 $1 的 SHA256 等于身份文件记录的 $2，无法读取或不一致时失败。
check_root_sha256() {
    actual=$(root_sha256 "$1") || fail "cannot hash test-root file: $root$1"
    actual=${actual%% *}
    [ "$actual" = "$2" ] || fail "test-root $1 SHA256 mismatch: expected $2, got $actual"
}

trap cleanup EXIT
trap 'exit 1' HUP INT TERM

[ "$#" -eq 1 ] || fail "usage: prepare-glibc-runtime /absolute/test/root"
root=$1
case "$root" in
    /) fail "test root must not be /" ;;
    /*/) root=${root%/} ;;
    /*) ;;
    *) fail "test root must be an absolute path: $root" ;;
esac
case "$root/" in
    *'/../'*|*'/./'*|*'//'*) fail "test root must not contain . or .. components: $root" ;;
esac
[ ! -L "$root" ] && [ -d "$root" ] || fail "test root is not a non-symlink directory: $root"
check_parent "$root/lib"
[ -d "$root/lib" ] || fail "test root has no lib directory: $root/lib"

lib_source=$runtime/lib/libgcc_s.so.1
[ -f "$lib_source" ] && [ ! -L "$lib_source" ] && [ -s "$lib_source" ] ||
    fail "missing or invalid libgcc source: $lib_source"

locale_rel=
for candidate in usr/lib/locale usr/lib64/locale; do
    source=$runtime/$candidate/C.utf8
    if [ -e "$source" ] || [ -L "$source" ]; then
        [ -z "$locale_rel" ] || fail "multiple C.utf8 locale sources in $runtime"
        locale_rel=$candidate/C.utf8
    fi
done
[ -n "$locale_rel" ] || fail "missing C.utf8 locale source in $runtime"
locale_source=$runtime/$locale_rel
[ -d "$locale_source" ] && [ ! -L "$locale_source" ] ||
    fail "invalid C.utf8 locale source: $locale_source"
[ -d "$locale_source/LC_MESSAGES" ] && [ ! -L "$locale_source/LC_MESSAGES" ] ||
    fail "invalid locale category: $locale_source/LC_MESSAGES"
for category in LC_CTYPE LC_NUMERIC LC_TIME LC_COLLATE LC_MONETARY \
    LC_MESSAGES/SYS_LC_MESSAGES LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE \
    LC_MEASUREMENT LC_IDENTIFICATION; do
    file=$locale_source/$category
    [ -f "$file" ] && [ ! -L "$file" ] && [ -s "$file" ] ||
        fail "missing or invalid locale category: $file"
done

locale_parent=${locale_rel%/C.utf8}
check_parent "$root/usr"
check_parent "$root/${locale_parent%/locale}"
check_parent "$root/$locale_parent"
lib_target=$root/lib/libgcc_s.so.1
locale_target=$root/$locale_rel
need_lib=0
need_locale=0

# 绝对链接必须在测试根内解析；在系统根直接 stat 会误判其目标。
if [ -L "$lib_target" ]; then
    "$bb" chroot "$root" /.blossom/busybox sh -c '[ -f "$1" ]' sh /lib/libgcc_s.so.1 ||
        fail "invalid or dangling libgcc target: $lib_target"
elif [ -e "$lib_target" ]; then
    [ -f "$lib_target" ] || fail "libgcc target is not a regular file: $lib_target"
else
    need_lib=1
fi
if [ -L "$locale_target" ]; then
    "$bb" chroot "$root" /.blossom/busybox sh -c '[ -d "$1" ]' sh "/$locale_rel" ||
        fail "invalid or dangling locale target: $locale_target"
elif [ -e "$locale_target" ]; then
    [ -d "$locale_target" ] || fail "locale target is not a directory: $locale_target"
else
    need_locale=1
fi

# 补入的 libgcc 和 locale 只适用于身份文件记录的 libc 与 loader；
# 两者的 SHA256 在创建任何临时文件或目标目录之前核对。
if [ "$need_lib" -eq 1 ] || [ "$need_locale" -eq 1 ]; then
    read_identity
    check_root_sha256 /lib/libc.so.6 "$libc_sum"
    check_root_sha256 "/lib/$loader_name" "$loader_sum"
fi

if [ "$need_lib" -eq 1 ]; then
    lib_tmp=$("$bb" mktemp "$root/lib/.libgcc_s.so.1.XXXXXX") || fail "cannot create temporary libgcc"
    "$bb" cp "$lib_source" "$lib_tmp" || fail "cannot copy libgcc"
    "$bb" chmod 644 "$lib_tmp" || fail "cannot set libgcc permissions"
    # 硬链接只在目标不存在时发表，避免覆盖后来出现的文件或符号链接。
    "$bb" ln -T "$lib_tmp" "$lib_target" || fail "cannot publish libgcc: $lib_target"
    "$bb" rm -f "$lib_tmp" || fail "cannot remove temporary libgcc: $lib_tmp"
    lib_tmp=
fi
if [ "$need_locale" -eq 1 ]; then
    "$bb" mkdir -p "$root/$locale_parent" || fail "cannot create locale parent: $root/$locale_parent"
    locale_tmp=$("$bb" mktemp -d "$root/$locale_parent/.C.utf8.XXXXXX") ||
        fail "cannot create temporary locale directory"
    "$bb" cp -R "$locale_source/." "$locale_tmp" || fail "cannot copy C.utf8 locale"
    "$bb" chmod 755 "$locale_tmp" || fail "cannot set locale directory permissions"
    [ ! -e "$locale_target" ] && [ ! -L "$locale_target" ] || fail "locale target appeared: $locale_target"
    "$bb" mv -nT "$locale_tmp" "$locale_target" || fail "cannot publish locale: $locale_target"
    [ ! -e "$locale_tmp" ] || fail "locale target appeared: $locale_target"
    locale_tmp=
fi
